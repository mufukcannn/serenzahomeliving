generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  staff
  shipping
  accounting
  customer_service
  customer
}

enum AdminModule {
  products
  inventory
  orders
  customers
  shipping
  marketplaces
  roles_permissions
  reports
}

enum PermissionAction {
  read
  create
  update
  delete
  export
  process
}

enum ProductStatus {
  draft
  active
  archived
}

enum CartStatus {
  active
  converted
  abandoned
}

enum PaymentStatus {
  pending
  authorized
  paid
  failed
  cancelled
  refunded
}

enum PaymentProvider {
  mock
  paytr
  iyzico
  stripe
  marketplace
}

enum CampaignDiscountType {
  percent
  fixed_amount
}

enum CampaignTargetType {
  all
  category
  collection
  product
  variant
}

enum OrderStatus {
  created
  paid
  processing
  preparing
  shipped
  delivered
  cancelled
  returned
}

enum OrderSource {
  website
  trendyol
  hepsiburada
  amazon
  n11
}

enum ShipmentStatus {
  not_ready
  label_created
  in_transit
  delivered
  exception
  returned
}

enum CarrierProvider {
  manual
  yurtici
}

enum MarketplaceChannel {
  trendyol
  hepsiburada
  amazon
  n11
}

enum MarketplaceAccountStatus {
  active
  paused
  disconnected
}

enum MarketplaceListingStatus {
  draft
  active
  passive
  rejected
}

enum InventoryReservationStatus {
  active
  committed
  released
  expired
}

enum ArticleStatus {
  draft
  published
  archived
}

enum ArticleCategory {
  buying_guide
  room_inspiration
  rug_care
  material_education
  size_guide
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String?
  role         UserRole  @default(customer)
  customer     Customer?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model RolePermission {
  id        String             @id @default(cuid())
  role      UserRole
  module    AdminModule
  actions   PermissionAction[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([role, module])
  @@index([role])
  @@index([module])
}

model Customer {
  id        String    @id @default(cuid())
  userId    String?   @unique
  email     String    @unique
  phone     String?
  firstName String
  lastName  String
  user      User?     @relation(fields: [userId], references: [id])
  addresses Address[]
  carts     Cart[]
  orders    Order[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Address {
  id             String    @id @default(cuid())
  customerId     String?
  fullName       String
  phone          String?
  line1          String
  line2          String?
  district       String
  city           String
  postalCode     String?
  country        String    @default("TR")
  invoiceType    String    @default("individual")
  taxOffice      String?
  taxNumber      String?
  customer       Customer? @relation(fields: [customerId], references: [id])
  shippingOrders Order[]   @relation("ShippingAddress")
  billingOrders  Order[]   @relation("BillingAddress")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Collection {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  description    String?
  heroImage      String?
  seoTitle       String?
  seoDescription String?
  status         String    @default("visible")
  sortOrder      Int       @default(0)
  products       Product[]
  articles       Article[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Product {
  id                    String                 @id @default(cuid())
  title                 String
  displayTitle          String?
  slug                  String                 @unique
  collectionId          String?
  collection            String
  category              String
  description           String
  price                 Decimal                @db.Decimal(12, 2)
  marketplacePrice      Decimal?               @db.Decimal(12, 2)
  basePrice             Decimal?               @db.Decimal(12, 2)
  webPrice              Decimal?               @db.Decimal(12, 2)
  salePrice             Decimal?               @db.Decimal(12, 2)
  compareAtPrice        Decimal?               @db.Decimal(12, 2)
  discountPercent       Decimal?               @db.Decimal(5, 2)
  finalPrice            Decimal?               @db.Decimal(12, 2)
  manualPriceOverride   Boolean                @default(false)
  stock                 Int                    @default(0)
  sku                   String                 @unique
  barcode               String?                @unique
  images                String[]
  sizes                 String[]
  colors                String[]
  seoTitle              String?
  seoDescription        String?
  feedEnabled           Boolean                @default(true)
  feedTitle             String?
  feedDescription       String?
  feedCategory          String?
  feedImageId           String?
  googleProductCategory String?
  attributes            Json?
  faqs                  Json?
  trendyolProductId     String?
  trendyolBarcode       String?
  trendyolUrl           String?
  status                ProductStatus          @default(active)
  collectionRef         Collection?            @relation(fields: [collectionId], references: [id])
  variants              ProductVariant[]
  productImages         ProductImage[]
  cartItems             CartItem[]
  orderItems            OrderItem[]
  inventories           Inventory[]
  reservations          InventoryReservation[]
  marketplaceListings   MarketplaceListing[]
  articles              Article[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([collectionId])
  @@index([category])
  @@index([status])
}

model ProductVariant {
  id                  String                 @id @default(cuid())
  productId           String
  title               String?
  size                String
  color               String
  sku                 String                 @unique
  barcode             String?                @unique
  price               Decimal                @db.Decimal(12, 2)
  marketplacePrice    Decimal?               @db.Decimal(12, 2)
  basePrice           Decimal?               @db.Decimal(12, 2)
  webPrice            Decimal?               @db.Decimal(12, 2)
  salePrice           Decimal?               @db.Decimal(12, 2)
  comparePrice        Decimal?               @db.Decimal(12, 2)
  compareAtPrice      Decimal?               @db.Decimal(12, 2)
  discountPercent     Decimal?               @db.Decimal(5, 2)
  finalPrice          Decimal?               @db.Decimal(12, 2)
  manualPriceOverride Boolean                @default(false)
  status              ProductStatus          @default(active)
  product             Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory           Inventory?
  cartItems           CartItem[]
  orderItems          OrderItem[]
  reservations        InventoryReservation[]
  marketplaceListings MarketplaceListing[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([productId])
  @@index([status])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  isHover   Boolean  @default(false)
  useInFeed Boolean  @default(false)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, sortOrder])
}

model Inventory {
  id           String                 @id @default(cuid())
  productId    String
  variantId    String?                @unique
  sku          String                 @unique
  onHand       Int                    @default(0)
  reserved     Int                    @default(0)
  safety       Int                    @default(0)
  product      Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant      ProductVariant?        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  reservations InventoryReservation[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([productId])
}

model InventoryReservation {
  id              String                     @id @default(cuid())
  inventoryId     String
  productId       String
  variantId       String?
  orderId         String?
  cartId          String?
  externalOrderId String?
  sku             String
  quantity        Int
  source          OrderSource
  status          InventoryReservationStatus @default(active)
  expiresAt       DateTime?
  committedAt     DateTime?
  releasedAt      DateTime?
  inventory       Inventory                  @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  product         Product                    @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant         ProductVariant?            @relation(fields: [variantId], references: [id])
  order           Order?                     @relation(fields: [orderId], references: [id])
  cart            Cart?                      @relation(fields: [cartId], references: [id])
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@index([inventoryId, status])
  @@index([productId, variantId, status])
  @@index([sku, source])
}

model Cart {
  id           String                 @id @default(cuid())
  customerId   String?
  sessionId    String?                @unique
  status       CartStatus             @default(active)
  customer     Customer?              @relation(fields: [customerId], references: [id])
  items        CartItem[]
  reservations InventoryReservation[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([customerId])
  @@index([status])
}

model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  title     String
  sku       String
  quantity  Int
  unitPrice Decimal         @db.Decimal(12, 2)
  total     Decimal         @db.Decimal(12, 2)
  color     String?
  size      String?
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([cartId])
}

model Order {
  id                     String                 @id @default(cuid())
  orderNumber            String                 @unique
  customerId             String?
  shippingAddressId      String?
  billingAddressId       String?
  customerSnapshot       Json
  addressSnapshot        Json
  subtotal               Decimal                @default(0) @db.Decimal(12, 2)
  shippingTotal          Decimal                @default(0) @db.Decimal(12, 2)
  discountTotal          Decimal                @default(0) @db.Decimal(12, 2)
  total                  Decimal                @db.Decimal(12, 2)
  paymentStatus          PaymentStatus          @default(pending)
  orderStatus            OrderStatus            @default(created)
  source                 OrderSource            @default(website)
  externalOrderId        String?                @unique
  commission             Decimal                @default(0) @db.Decimal(12, 2)
  cargoCost              Decimal                @default(0) @db.Decimal(12, 2)
  marketplaceFee         Decimal                @default(0) @db.Decimal(12, 2)
  netProfit              Decimal                @default(0) @db.Decimal(12, 2)
  shippingServiceLevel   String?
  shippingRequiresReview Boolean                @default(false)
  assignedTo             String?
  invoiceType            String                 @default("individual") @map("invoice_type")
  invoiceStatus          String                 @default("not_issued") @map("invoice_status")
  invoiceNumber          String?                @map("invoice_number")
  invoiceUrl             String?                @map("invoice_url")
  billingName            String?                @map("billing_name")
  billingCompany         String?                @map("billing_company")
  billingTaxNumber       String?                @map("billing_tax_number")
  billingTaxOffice       String?                @map("billing_tax_office")
  billingAddressText     String?                @map("billing_address")
  notes                  Json?
  customer               Customer?              @relation(fields: [customerId], references: [id])
  shippingAddress        Address?               @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  billingAddress         Address?               @relation("BillingAddress", fields: [billingAddressId], references: [id])
  items                  OrderItem[]
  payments               Payment[]
  shipment               Shipment?
  reservations           InventoryReservation[]
  marketplaceOrder       MarketplaceOrder?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@index([customerId])
  @@index([source, orderStatus])
  @@index([paymentStatus])
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  productId String
  variantId String?
  title     String
  sku       String
  barcode   String?
  quantity  Int
  unitPrice Decimal         @db.Decimal(12, 2)
  total     Decimal         @db.Decimal(12, 2)
  color     String?
  size      String?
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model Payment {
  id            String          @id @default(cuid())
  orderId       String
  provider      PaymentProvider
  providerRef   String?
  sessionId     String?
  status        PaymentStatus   @default(pending)
  amount        Decimal         @db.Decimal(12, 2)
  currency      String          @default("TRY")
  checkoutUrl   String?
  installment   Int             @default(1)
  gatewayStatus String?
  cardFamily    String?
  fraudScore    Decimal?        @db.Decimal(5, 2)
  failureReason String?
  rawPayload    Json?
  paidAt        DateTime?
  failedAt      DateTime?
  expiresAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  logs          PaymentLog[]

  @@unique([provider, providerRef])
  @@index([orderId])
  @@index([status, createdAt])
}

model PaymentLog {
  id           String          @id @default(cuid())
  orderId      String?
  paymentId    String?
  provider     PaymentProvider
  eventType    String
  status       PaymentStatus?
  providerRef  String?
  merchantOid  String?
  amount       Decimal?        @db.Decimal(12, 2)
  installment  Int?
  fraudScore   Decimal?        @db.Decimal(5, 2)
  riskLevel    String?
  ipAddress    String?
  userAgent    String?
  hashVerified Boolean         @default(false)
  duplicate    Boolean         @default(false)
  errorMessage String?
  rawPayload   Json?
  createdAt    DateTime        @default(now())
  payment      Payment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([provider, providerRef])
  @@index([eventType, createdAt])
  @@index([status, createdAt])
}

model Coupon {
  id              String    @id @default(cuid())
  code            String    @unique
  description     String?
  discountType    String
  discountValue   Decimal   @db.Decimal(12, 2)
  minimumSubtotal Decimal?  @db.Decimal(12, 2)
  startsAt        DateTime?
  endsAt          DateTime?
  usageLimit      Int?
  usedCount       Int       @default(0)
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([active, startsAt, endsAt])
}

model PricingCampaign {
  id            String               @id @default(cuid())
  name          String
  discountType  CampaignDiscountType @default(percent)
  discountValue Decimal              @db.Decimal(12, 2)
  targetType    CampaignTargetType   @default(all)
  targetValue   String?
  productIds    String[]             @default([])
  variantIds    String[]             @default([])
  startsAt      DateTime?
  endsAt        DateTime?
  active        Boolean              @default(true)
  priority      Int                  @default(100)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([active, priority])
  @@index([targetType])
  @@index([startsAt, endsAt])
}

model IntegrationSetting {
  id               String           @id @default(cuid())
  category         String
  provider         String
  label            String
  active           Boolean          @default(false)
  mode             String           @default("test")
  isDefault        Boolean          @default(false)
  syncInterval     Int?
  config           Json?
  encryptedSecrets Json?
  lastSyncAt       DateTime?
  lastTestStatus   String?
  lastTestError    String?
  lastTestedAt     DateTime?
  lastSuccessfulAt DateTime?
  logs             IntegrationLog[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([category, provider])
  @@index([category, active])
  @@index([provider])
}

model IntegrationLog {
  id         String              @id @default(cuid())
  settingId  String?
  category   String
  provider   String
  operation  String
  success    Boolean             @default(false)
  statusCode Int?
  error      String?
  createdAt  DateTime            @default(now())
  setting    IntegrationSetting? @relation(fields: [settingId], references: [id], onDelete: SetNull)

  @@index([settingId, createdAt])
  @@index([provider, operation])
  @@index([success, createdAt])
}

model Shipment {
  id             String          @id @default(cuid())
  orderId        String          @unique
  provider       CarrierProvider @default(manual)
  carrier        String?
  trackingCode   String?
  trackingUrl    String?
  shipmentStatus ShipmentStatus  @default(not_ready)
  shippingCost   Decimal         @default(0) @db.Decimal(12, 2)
  labelUrl       String?
  assignedUserId String?
  lastSyncedAt   DateTime?
  statusHistory  Json?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  rawPayload     Json?
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([shipmentStatus])
}

model MarketplaceAccount {
  id           String                   @id @default(cuid())
  channel      MarketplaceChannel
  name         String
  supplierId   String?
  apiKey       String?
  apiSecretRef String?
  baseUrl      String?
  status       MarketplaceAccountStatus @default(active)
  listings     MarketplaceListing[]
  orders       MarketplaceOrder[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@unique([channel, name])
}

model MarketplaceListing {
  id                String                   @id @default(cuid())
  accountId         String
  productId         String
  variantId         String?
  channel           MarketplaceChannel
  externalProductId String?
  externalSku       String?
  barcode           String?
  url               String?
  status            MarketplaceListingStatus @default(draft)
  lastSyncedAt      DateTime?
  account           MarketplaceAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  product           Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant           ProductVariant?          @relation(fields: [variantId], references: [id])
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@unique([channel, externalSku])
  @@index([accountId])
  @@index([productId, channel])
}

model MarketplaceOrder {
  id                String             @id @default(cuid())
  accountId         String
  orderId           String?            @unique
  channel           MarketplaceChannel
  externalOrderId   String
  externalPackageId String?
  rawPayload        Json
  importedAt        DateTime?
  account           MarketplaceAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  order             Order?             @relation(fields: [orderId], references: [id])
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([channel, externalOrderId])
  @@index([accountId])
}

model Article {
  id             String          @id @default(cuid())
  title          String
  slug           String          @unique
  excerpt        String
  body           Json
  category       ArticleCategory
  status         ArticleStatus   @default(draft)
  heroImage      String?
  seoTitle       String?
  seoDescription String?
  faq            Json?
  publishedAt    DateTime?
  collectionId   String?
  productId      String?
  collection     Collection?     @relation(fields: [collectionId], references: [id])
  product        Product?        @relation(fields: [productId], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([category, status])
  @@index([collectionId])
  @@index([productId])
}
